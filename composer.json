{
    "name": "michaelkaefer/table",
    "type": "library",
    "description": "An extensible component for rendering tables",
    "keywords": ["table"],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Contributors",
            "homepage": "https://github.com/michaelKaefer/table/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/options-resolver": "8.2.x-dev",
        "symfony/property-access": "8.2.x-dev",
        "symfony/string": "8.2.x-dev"
    },
    "suggest": {
        "twig/twig": "^3.30"
    },
    "autoload": {
        "psr-4": {
            "MichaelKaefer\\Table\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MichaelKaefer\\Table\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "twig/twig": "^3.30"
    },
    "extra": {
        "branch-alias": {
            "dev-0.x": "0.1.x-dev"
        }
    }
}
